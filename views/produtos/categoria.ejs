<h1>Produtos — Categoria: <%= categoria.nome %></h1>

<p>
    <a href="/produtos">← Todos os produtos</a> | 
    <a href="/produtos/novo">Novo produto</a> | 
    <a href="/categorias">Gerenciar Categorias</a>
</p>

<!-- Seletor rápido de categorias (Desafio 2) -->
<div style="margin: 15px 0;">
    <label><strong>Trocar categoria:</strong></label>
    <select onchange="if (this.value) { window.location.href = '/produtos/categoria/' + this.value; } else { window.location.href = '/produtos'; }">
        <option value="">Todas as categorias</option>
        <% if (typeof categorias !== 'undefined') { %>
            <% categorias.forEach(c => { %>
                <option value="<%= c.id %>" <%= c.id === categoria.id ? 'selected' : '' %>><%= c.nome %></option>
            <% }) %>
        <% } %>
    </select>
</div>

<table border="1" cellpadding="6">
    <tr>
        <th>Nome</th>
        <th>Preço</th>
        <th>Quantidade</th>
        <th>Categoria</th>
        <th>Ações</th>
    </tr>

    <% if (produtos.length === 0) { %>
        <tr>
            <td colspan="5" align="center">Nenhum produto cadastrado nesta categoria.</td>
        </tr>
    <% } %>

    <% produtos.forEach(p => { %>

        <tr>
            <td><%= p.nome %></td>
            <td>R$ <%= Number(p.preco).toFixed(2) %></td>
            <td><%= p.quantidade %></td>
            <td><%= categoria.nome %></td>

            <td>
                <a href="/produtos/<%= p.id %>/editar">
                    Editar
                </a>

                <form
                    action="/produtos/<%= p.id %>/deletar"
                    method="POST"
                    style="display:inline"
                >
                    <button type="submit">
                        Excluir
                    </button>
                </form>
            </td>
        </tr>

    <% }) %>

</table>
